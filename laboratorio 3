// src/alu.v
`timescale 1ns / 1ps

module alu (
    input  wire [3:0] A,        // Operando A (4 bits)
    input  wire [3:0] B,        // Operando B (4 bits)
    input  wire [2:0] opcode,   // Operación seleccionada por SW[2:0] (3 bits)
    output reg  [3:0] result    // Resultado de la ALU (4 bits)
);

    // Lógica combinacional pura
    always @(*) begin
        case (opcode)
            3'b000:  result = A + B;       // Suma
            3'b001:  result = A - B;       // Resta
            3'b010:  result = A & B;       // AND bit a bit
            3 me011:  result = A | B;       // OR bit a bit
            3'b100:  result = A ^ B;       // XOR bit a bit
            3'b101:  result = ~A;          // NOT en Operando A
            3'b110:  result = A << 1;      // Desplazamiento lógico izquierda
            3'b111:  result = A >> 1;      // Desplazamiento lógico derecha
            default: result = 4'b0000;     // Estado de seguridad por defecto
        endcase
    end

endmodule

// src/comb_selector.v
`timescale 1ns / 1ps

module comb_selector (
    input  wire       clk,            // Reloj principal (125 MHz)
    input  wire       btn_next_comb,  // BTN2: Cambia a la siguiente combinación
    output reg  [1:0] read_addr_a,    // Dirección del registro para Operando A
    output reg  [1:0] read_addr_b,    // Dirección del registro para Operando B
    output reg  [3:0] active_leds     // Salida hacia los LEDs (LED[3:0])
);

    reg [2:0] comb_index = 3'b000;
    reg btn_next_prev = 1'b0;

    // Lógica secuencial: Avanzar el contador de combinación con BTN2
    always @(posedge clk) begin
        btn_next_prev <= btn_next_comb;

        if (btn_next_comb && !btn_next_prev) begin
            if (comb_index == 3'd5)
                comb_index <= 3'b000;
            else
                comb_index <= comb_index + 1'b1;
        end
    end

    // Lógica combinacional: Mapeo del índice a direcciones y LEDs
    always @(*) begin
        case (comb_index)
            3'd0: begin // Pareja (R0, R1)
                read_addr_a = 2'b00;
                read_addr_b = 2'b01;
                active_leds = 4'b0011;
            end
            3'd1: begin // Pareja (R0, R2)
                read_addr_a = 2'b00;
                read_addr_b = 2'b10;
                active_leds = 4'b0101;
            end
            3'd2: begin // Pareja (R0, R3)
                read_addr_a = 2'b00;
                read_addr_b = 2'b11;
                active_leds = 4'b1001;
            end
            3'd3: begin // Pareja (R1, R2)
                read_addr_a = 2'b01;
                read_addr_b = 2'b10;
                active_leds = 4'b0110;
            end
            3'd4: begin // Pareja (R1, R3)
                read_addr_a = 2'b01;
                read_addr_b = 2'b11;
                active_leds = 4'b1010;
            end
            3'd5: begin // Pareja (R2, R3)
                read_addr_a = 2'b10;
                read_addr_b = 2'b11;
                active_leds = 4'b1100;
            end
            default: begin
                read_addr_a = 2'b00;
                read_addr_b = 2'b01;
                active_leds = 4'b0011;
            end
        endcase
    end

endmodule

// src/display_tm1637.v
`timescale 1ns / 1ps

module display_tm1637 (
    input  wire       clk,          // 125 MHz
    input  wire       btn_exec,     // BTN3: Ejecuta latcheo y actualización
    input  wire [3:0] alu_result,
    output reg        clk_display = 1'b1,
    inout  wire       dio_display
);

    // Latch del resultado con BTN3
    reg [1:0] btn_sync = 2'b00;
    reg       btn_prev = 1'b0;
    reg [3:0] latched_result = 4'h0;

    always @(posedge clk) begin
        btn_sync <= {btn_sync[0], btn_exec};
        btn_prev <= btn_sync[1];
        if (btn_sync[1] && !btn_prev)
            latched_result <= alu_result;
    end

    // Decodificador hex -> 7 segmentos
    function [7:0] seg7_map(input [3:0] d);
        case (d)
            4'h0: seg7_map = 8'h3F; 4'h1: seg7_map = 8'h06;
            4'h2: seg7_map = 8'h5B; 4'h3: seg7_map = 8'h4F;
            4'h4: seg7_map = 8'h66; 4'h5: seg7_map = 8'h6D;
            4'h6: seg7_map = 8'h7D; 4'h7: seg7_map = 8'h07;
            4'h8: seg7_map = 8'h7F; 4'h9: seg7_map = 8'h6F;
            4'hA: seg7_map = 8'h77; 4'hB: seg7_map = 8'h7C;
            4'hC: seg7_map = 8'h39; 4'hD: seg7_map = 8'h5E;
            4'hE: seg7_map = 8'h79; 4'hF: seg7_map = 8'h71;
            default: seg7_map = 8'h00;
        endcase
    endfunction

    // Tick de habilitación (100 kHz)
    reg [10:0] tick_cnt = 11'd0;
    wire       tick = (tick_cnt == 11'd1249);
    always @(posedge clk)
        tick_cnt <= tick ? 11'd0 : tick_cnt + 1'b1;

    // Buffer Tri-state DIO
    reg dio_out = 1'b1;
    reg dio_oe  = 1'b1;
    assign dio_display = dio_oe ? dio_out : 1'bz;

    // Máquina de estados I2C-like para TM1637
    localparam S_START0 = 4'd0, S_START1 = 4'd1, S_LOAD = 4'd2,
               S_SETUP  = 4'd3, S_HIGH   = 4'd4, S_FALL = 4'd5,
               S_ACK_REL= 4'd6, S_ACK_H  = 4'd7, S_ACK_L= 4'd8,
               S_ACK_TAKE=4'd9, S_STOP1  = 4'd10,S_STOP2= 4'd11;

    reg [3:0] st        = S_START0;
    reg [1:0] byte_idx  = 2'd0;
    reg [7:0] shift_reg = 8'd0;
    reg [2:0] bit_cnt   = 3'd0;
    reg [7:0] cur_byte;

    always @(*) begin
        case (byte_idx)
            2'd0:    cur_byte = 8'h44;                    // Dirección fija
            2'd1:    cur_byte = 8'hC0;                    // Dígito 1
            2'd2:    cur_byte = seg7_map(latched_result); // Dato codificado
            default: cur_byte = 8 me8F;                    // Encendido + brillo
        endcase
    end

    always @(posedge clk) begin
        if (tick) begin
            case (st)
                S_START0: begin dio_oe <= 1'b1; clk_display <= 1'b1; dio_out <= 1'b1; st <= S_START1; end
                S_START1: begin dio_out <= 1'b0; st <= S_LOAD; end
                S_LOAD:   begin clk_display <= 1'b0; shift_reg <= cur_byte; bit_cnt <= 3'd0; st <= S_SETUP; end
                S_SETUP:  begin dio_out <= shift_reg[0]; st <= S_HIGH; end
                S_HIGH:   begin clk_display <= 1'b1; st <= S_FALL; end
                S_FALL:   begin clk_display <= 1'b0; shift_reg <= {1'b0, shift_reg[7:1]};
                                if (bit_cnt == 3'd7) st <= S_ACK_REL;
                                else begin bit_cnt <= bit_cnt + 1'b1; st <= S_SETUP; end
                          end
                S_ACK_REL:begin dio_oe <= 1'b0; st <= S_ACK_H; end
                S_ACK_H:  begin clk_display <= 1'b1; st <= S_ACK_L; end
                S_ACK_L:  begin clk_display <= 1'b0; st <= S_ACK_TAKE; end
                S_ACK_TAKE:begin dio_oe <= 1 me1; dio_out <= 1'b0;
                                 if (byte_idx == 2'd1) begin byte_idx <= 2'd2; st <= S_LOAD; end
                                 else st <= S_STOP1;
                           end
                S_STOP1:  begin clk_display <= 1'b1; st <= S_STOP2; end
                S_STOP2:  begin dio_out <= 1'b1; byte_idx <= (byte_idx == 2'd3) ? 2'd0 : byte_idx + 1'b1; st <= S_START0; end
                default:  st <= S_START0;
            endcase
        end
    end

endmodule

// src/reg_bank.v
`timescale 1ns / 1ps

module reg_bank (
    input  wire       clk,
    input  wire       write_enable,   // BTN1: Carga valor de SW en registro actual
    input  wire       btn_sel_reg,    // BTN0: Selecciona registro (0..3)
    input  wire [3:0] data_in,        // SW[3:0]
    input  wire [1:0] read_addr_a,
    input  wire [1:0] read_addr_b,
    output wire [3:0] data_out_a,
    output wire [3:0] data_out_b,
    output reg  [1:0] write_ptr = 2'b00
);

    reg [3:0] registers [3:0];
    reg btn_sel_prev = 1'b0;
    reg write_en_prev = 1'b0;

    integer i;
    initial begin
        for (i = 0; i < 4; i = i + 1)
            registers[i] = 4'b0000;
    end

    always @(posedge clk) begin
        btn_sel_prev  <= btn_sel_reg;
        write_en_prev <= write_enable;

        // Avanza puntero de escritura con flanco de subida en BTN0
        if (btn_sel_reg && !btn_sel_prev)
            write_ptr <= write_ptr + 1'b1;

        // Escribe en el registro activo con flanco de subida en BTN1
        if (write_enable && !write_en_prev)
            registers[write_ptr] <= data_in;
    end

    assign data_out_a = registers[read_addr_a];
    assign data_out_b = registers[read_addr_b];

endmodule

## Archivo `top.v`

// top.v
`timescale 1ns / 1ps

module top (
    input  wire       clk,          // Reloj de 125 MHz (Zybo Z7)
    input  wire [3:0] BTN,          // BTN0=SelReg, BTN1=Write, BTN2=NextComb, BTN3=Exec
    input  wire [3:0] SW,           // Entradas por interruptores (Datos / Opcode)
    output wire [3:0] LED,          // Indicadores de pareja de registros seleccionada
    output wire       RGB_R, RGB_G, RGB_B, // Indicador LED RGB de registro de escritura
    output wire       clk_display,  // Reloj serial hacia TM1637
    inout  wire       dio_display   // Línea bidireccional de datos TM1637
);

    wire [1:0] read_addr_a, read_addr_b;
    wire [1:0] write_ptr;
    wire [3:0] data_out_a, data_out_b;
    wire [3:0] alu_result;

    // 1. Selector de Combinaciones entre Registros
    comb_selector u_comb_selector (
        .clk(clk),
        .btn_next_comb(BTN[2]),
        .read_addr_a(read_addr_a),
        .read_addr_b(read_addr_b),
        .active_leds(LED)
    );

    // 2. Banco de Registros (4 registros x 4 bits)
    reg_bank u_reg_bank (
        .clk(clk),
        .write_enable(BTN[1]),
        .btn_sel_reg(BTN[0]),
        .data_in(SW[3:0]),
        .read_addr_a(read_addr_a),
        .read_addr_b(read_addr_b),
        .data_out_a(data_out_a),
        .data_out_b(data_out_b),
        .write_ptr(write_ptr)
    );

    // 3. Unidad Lógico Aritmética (ALU)
    alu u_alu (
        .A(data_out_a),
        .B(data_out_b),
        .opcode(SW[2:0]),
        .result(alu_result)
    );

    // 4. Controlador de Pantalla TM1637 con Latch de actualización
    display_tm1637 u_display (
        .clk(clk),
        .btn_exec(BTN[3]),
        .alu_result(alu_result),
        .clk_display(clk_display),
        .dio_display(dio_display)
    );

    // Mapeo visual LED RGB según el registro de escritura activo (write_ptr)
    assign RGB_R = (write_ptr == 2'b00) || (write_ptr == 2'b11);
    assign RGB_G = (write_ptr == 2'b01) || (write_ptr == 2'b11);
    assign RGB_B = (write_ptr == 2'b10);

endmodule

## Testbench completo (`tb_top_lab03.v`)

// testbench/tb_top_lab03.v
`timescale 1ns / 1ps

module tb_top_lab03;

    reg        clk;
    reg  [3:0] BTN;
    reg  [3:0] SW;
    wire [3:0] LED;
    wire       RGB_R, RGB_G, RGB_B;
    wire       clk_display;
    wire       dio_display;

    // Instanciación de la UUT (Unit Under Test)
    top uut (
        .clk(clk),
        .BTN(BTN),
        .SW(SW),
        .LED(LED),
        .RGB_R(RGB_R),
        .RGB_G(RGB_G),
        .RGB_B(RGB_B),
        .clk_display(clk_display),
        .dio_display(dio_display)
    );

    // Generación de reloj de 125 MHz (período = 8ns)
    always #4 clk = ~clk;

    initial begin
        // Generación de archivo VCD obligatorio para simulación GTKWave
        $dumpfile("sim/tb_top_lab03.vcd");
        $dumpvars(0, tb_top_lab03);

        // Inicialización de señales
        clk = 0;
        BTN = 4'b0000;
        SW  = 4'b0000;

        #40;

        // 1. Carga de datos en los registros
        // Cargar R0 = 5 (SW=5, BTN[1] pulso)
        SW = 4'd5; #40; BTN[1] = 1; #40; BTN[1] = 0; #40;

        // Seleccionar R1 (BTN[0] pulso) y Cargar R1 = 3
        BTN[0] = 1; #40; BTN[0] = 0; #40;
        SW = 4'd3; #40; BTN[1] = 1; #40; BTN[1] = 0; #40;

        // Seleccionar R2 (BTN[0] pulso) y Cargar R2 = 8
        BTN[0] = 1; #40; BTN[0] = 0; #40;
        SW = 4'd8; #40; BTN[1] = 1; #40; BTN[1] = 0; #40;

        // Seleccionar R3 (BTN[0] pulso) y Cargar R3 = 2
        BTN[0] = 1; #40; BTN[0] = 0; #40;
        SW = 4'd2; #40; BTN[1] = 1; #40; BTN[1] = 0; #40;

        // 2. Probar ALU: Operación Suma (opcode = 000) sobre R0 (5) y R1 (3) -> Resultado = 8
        SW = 4'b0000; #40;
        // Ejecutar en Display (BTN[3] pulso)
        BTN[3] = 1; #40; BTN[3] = 0; #40;

        #1000;

        // 3. Probar ALU: Operación Resta (opcode = 001) -> Resultado = 2
        SW = 4'b0001; #40;
        BTN[3] = 1; #40; BTN[3] = 0; #40;

        #1000;

        // 4. Cambiar combinación de registros a (R0, R2) presionando BTN[2]
        BTN[2] = 1; #40; BTN[2] = 0; #40;
        SW = 4'b0000; #40; // Suma 5 + 8 = 13 (0xD)
        BTN[3] = 1; #40; BTN[3] = 0; #40;

        #200000; // Tiempo para observar serialización TM1637

        $finish;
    end

endmodule

